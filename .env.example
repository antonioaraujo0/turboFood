# ---------------------------------------------------------------------------
# Backend TurboFood — variáveis de ambiente
# Copie para .env (local) ou configure no painel do Render.
# ---------------------------------------------------------------------------

# Porta (o Render injeta automaticamente; local usa 3000)
PORT=3000

# --- Opção A: Postgres via URL única (Render usa isto) ---
# DATABASE_URL=postgres://usuario:senha@host:5432/turbofood

# --- Opção B: Postgres via variáveis discretas (dev local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=turbofood
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# --- Opção C: SQLite (dev rápido, sem servidor Postgres) ---
# DB_DIALECT=sqlite
# DB_STORAGE=./database.sqlite

# Origem(ns) do frontend liberada(s) no CORS (separadas por vírgula).
# Ex.: https://turbofood-web.onrender.com
# Sem esta variável, o CORS libera todas as origens.
CORS_ORIGIN=
